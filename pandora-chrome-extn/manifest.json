{
    "manifest_version": 3,
    "name": "Pandora Data Extractor",
    "version": "1.0",
    "permissions": [
        "activeTab",
        "scripting",
        "notifications"
    ],
    "host_permissions": [
        "*://*.pandora.net/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.pandora.net/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}